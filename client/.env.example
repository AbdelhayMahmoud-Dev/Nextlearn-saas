# ─────────────────────────────────────────────────────────────
#  NextLearn Client — Environment Variables
#  Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# Express API base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Active tenant for local dev (the Mongo ObjectId of your tenant; see server `npm run seed:tenant`).
# In production the tenant is resolved from the subdomain instead.
NEXT_PUBLIC_TENANT_ID=

# NextAuth (Auth.js v5) — generate with `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Back-compat aliases (some tooling still reads these)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Deferred to later phases (Stripe / Google OAuth / Cloudinary / Socket.io)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
