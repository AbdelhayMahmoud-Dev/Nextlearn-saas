# ─────────────────────────────────────────────────────────────
#  NextLearn API — Environment Variables
#  Copy to `.env` and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
# Local dev port. In production (Railway/Render) PORT is injected by the platform
# and MUST NOT be hardcoded — the app reads process.env.PORT and defaults to 8080.
PORT=5000

# Database (MongoDB Atlas or local)
MONGODB_URI=mongodb://

# JWT — generate strong secrets, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin(s) — comma-separated whitelist for CORS
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Email (Resend) — optional in dev; links are logged to console if unset
RESEND_API_KEY=
EMAIL_FROM=NextLearn <noreply@nextlearn.com>

# Redis — optional in dev; caching/rate-limit store no-ops if unset
REDIS_URL=

# Stripe — required for Phase 4 (payments). The app/seed scripts still boot
# without these; payment endpoints return 503 until configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# Cloudinary — required for Phase 3 (media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Learning Assistant (Phase 8.2). Optional: defaults to the built-in local
# provider. Set AI_PROVIDER=openai|anthropic and the matching key to use a
# hosted model; if the key is missing the service falls back to local.
AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
AI_MAX_OUTPUT_TOKENS=1024
AI_TEMPERATURE=0.4
