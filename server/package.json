{
  "name": "nextlearn-server",
  "version": "0.1.0",
  "description": "NextLearn — White-Label SaaS LMS API (Express + TypeScript + MongoDB)",
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed:tenant": "tsx src/scripts/seedTenant.ts",
    "seed:courses": "tsx src/scripts/seedCourses.ts",
    "seed:extras": "tsx src/scripts/seedExtras.ts",
    "verify:models": "tsx src/scripts/verifyModels.ts",
    "docs:api": "tsx src/scripts/generateDocs.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/jsdom": "^28.0.3",
    "@types/node-cron": "^3.0.11",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.2",
    "isomorphic-dompurify": "^3.15.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "lowlight": "^3.3.0",
    "mongoose": "^8.9.5",
    "node-cron": "^4.2.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "react-dropzone": "^15.0.0",
    "resend": "^4.0.1",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "stripe": "^22.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
